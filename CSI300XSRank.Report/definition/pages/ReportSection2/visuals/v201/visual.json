{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "v201",
  "position": {
    "x": 0,
    "y": 90,
    "z": 0,
    "width": 1280,
    "height": 380,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_group_return"
                    }
                  },
                  "Property": "trade_date"
                }
              },
              "queryRef": "Category.fact_group_return.trade_date"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Aggregation": {
                  "Expression": {
                    "Column": {
                      "Expression": {
                        "SourceRef": {
                          "Entity": "fact_group_return"
                        }
                      },
                      "Property": "nav"
                    }
                  },
                  "Function": 0
                }
              },
              "queryRef": "Y.Sum(fact_group_return.nav)"
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_group_return"
                    }
                  },
                  "Property": "group"
                }
              },
              "queryRef": "Series.fact_group_return.group"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": []
      }
    },
    "objects": {
      "title": [
        {
          "properties": {
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'净值走势：Q1 vs Q5 vs 基准'"
                }
              }
            },
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}